{
  "sourceLanguage": "en",
  "strings": {
    "%@ or the passcode on this iPhone changed, so %@ unlock is off. Unlock with your password and turn it on again in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير %1$@ أو رمز الدخول على جهاز iPhone هذا، لذا تم إيقاف فتح القفل باستخدام %2$@. افتح القفل باستخدام كلمة السر وأعد تشغيله من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ oder der Code auf diesem iPhone wurde geändert, daher ist das Entsperren mit %2$@ deaktiviert. Entsperren Sie mit Ihrem Passwort und aktivieren Sie es in den Einstellungen erneut."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ or the passcode on this iPhone changed, so %2$@ unlock is off. Unlock with your password and turn it on again in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ o el código de este iPhone ha cambiado, por lo que el desbloqueo con %2$@ está desactivado. Desbloquea con tu contraseña y vuelve a activarlo en Ajustes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ o el código de este iPhone cambió, por lo que el desbloqueo con %2$@ está desactivado. Desbloquea con tu contraseña y vuelve a activarlo en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ou le code de cet iPhone a changé, le déverrouillage par %2$@ est donc désactivé. Déverrouillez avec votre mot de passe, puis réactivez-le dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone पर %1$@ या पासकोड बदल गया है, इसलिए %2$@ से अनलॉक करना बंद कर दिया गया है। अपने पासवर्ड से अनलॉक करें और सेटिंग्ज़ में इसे फिर से चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ atau kode sandi di iPhone ini telah berubah, sehingga buka kunci dengan %2$@ dinonaktifkan. Buka kunci dengan kata sandi Anda, lalu aktifkan lagi di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ o il codice di questo iPhone sono cambiati, quindi lo sblocco con %2$@ è disattivato. Sblocca con la password e riattivalo in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneの%1$@またはパスコードが変更されたため、%2$@によるロック解除はオフになりました。パスワードでロックを解除し、設定でもう一度オンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 %1$@ 또는 암호가 변경되어 %2$@ 잠금 해제가 꺼졌습니다. 비밀번호로 잠금 해제한 후 설정에서 다시 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of de toegangscode van deze iPhone is gewijzigd, dus ontgrendelen met %2$@ is uitgeschakeld. Ontgrendel met je wachtwoord en schakel het opnieuw in via Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lub kod tego iPhone’a zostały zmienione, więc odblokowywanie za pomocą %2$@ jest wyłączone. Odblokuj hasłem i włącz je ponownie w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ou o código deste iPhone foi alterado, então o desbloqueio com %2$@ foi desativado. Desbloqueie com sua senha e ative-o novamente em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ou o código deste iPhone foi alterado, pelo que o desbloqueio com %2$@ foi desativado. Desbloqueie com a sua palavra-passe e volte a ativá-lo nas Definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ или код-пароль на этом iPhone изменились, поэтому разблокировка через %2$@ отключена. Разблокируйте паролем и снова включите её в Настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ eller lösenkoden på den här iPhonen har ändrats, så upplåsning med %2$@ är avstängd. Lås upp med ditt lösenord och aktivera det igen i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ หรือรหัสของ iPhone เครื่องนี้มีการเปลี่ยนแปลง การปลดล็อกด้วย %2$@ จึงถูกปิด ปลดล็อกด้วยรหัสผ่านของคุณ แล้วเปิดอีกครั้งในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone’daki %1$@ veya parola değişti, bu nedenle %2$@ ile kilit açma kapatıldı. Şifrenizle kilidi açın ve Ayarlar’dan yeniden etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ або код-пароль на цьому iPhone змінилися, тому розблокування через %2$@ вимкнено. Розблокуйте паролем і знову ввімкніть його в Параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hoặc mật mã trên iPhone này đã thay đổi nên tính năng mở khóa bằng %2$@ đã bị tắt. Hãy mở khóa bằng mật khẩu và bật lại trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 上的 %1$@ 或锁屏密码已更改，因此 %2$@ 解锁已关闭。请使用你的钱包密码解锁，然后在“设置”中重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 iPhone 的 %1$@ 或裝置密碼已變更，因此 %2$@ 解鎖已關閉。請使用你的錢包密碼解鎖，然後在「設定」中重新開啟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ or the passcode on this iPhone changed, so %2$@ unlock is off. Unlock with your password and turn it on again in Settings."
          }
        }
      }
    },
