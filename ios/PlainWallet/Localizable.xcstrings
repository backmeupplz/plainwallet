    "That looks like a seed phrase or private key. Never type it into a website.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن هذه عبارة استرداد أو مفتاح خاص. لا تكتبها أبدًا في أي موقع ويب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nach einer Seed-Phrase oder einem privaten Schlüssel aus. Geben Sie so etwas niemals auf einer Website ein."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "That looks like a seed phrase or private key. Never type it into a website."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece una frase semilla o una clave privada. Nunca la escribas en un sitio web."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece una frase semilla o una clave privada. Nunca la escribas en un sitio web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ressemble à une phrase de récupération ou à une clé privée. Ne la saisissez jamais sur un site web."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सीड फ़्रेज़ या प्राइवेट की जैसा लगता है। इसे कभी भी किसी वेबसाइट में न लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepertinya itu frasa pemulihan atau kunci privat. Jangan pernah mengetikkannya di situs web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra una frase di recupero o una chiave privata. Non inserirla mai in un sito web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シードフレーズまたは秘密鍵のようです。Webサイトには絶対に入力しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시드 구문 또는 개인 키로 보입니다. 절대 웹사이트에 입력하지 마세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat lijkt op een herstelzin of privésleutel. Typ deze nooit op een website."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wygląda na frazę seed lub klucz prywatny. Nigdy nie wpisuj ich na żadnej stronie internetowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso parece uma frase de recuperação ou uma chave privada. Nunca digite isso em um site."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto parece uma frase de recuperação ou uma chave privada. Nunca a escreva num site."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже на сид-фразу или приватный ключ. Никогда не вводите их на сайтах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det där ser ut som en återställningsfras eller en privat nyckel. Skriv aldrig in den på en webbplats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความนี้ดูเหมือนวลีกู้คืนหรือคีย์ส่วนตัว ห้ามพิมพ์ลงในเว็บไซต์ใดๆ เด็ดขาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir seed ifadesi veya özel anahtar gibi görünüyor. Bunu asla bir web sitesine yazmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже на сід-фразу або приватний ключ. Ніколи не вводьте їх на сайтах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây có vẻ là cụm từ khôi phục hoặc khóa riêng tư. Đừng bao giờ nhập nó vào trang web."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来像助记词或私钥。切勿在任何网站中输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這看起來像是助記詞或私鑰。請勿在任何網站中輸入。"
          }
        }
      }
    },
    "This iPhone can't keep a key behind %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لجهاز iPhone هذا حماية مفتاح باستخدام %@"
          }
        },
        "de": {
