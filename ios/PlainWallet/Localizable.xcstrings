    "Search or type web address": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث أو اكتب عنوان ويب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen oder Webadresse eingeben"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Search or type web address"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar o escribir dirección web"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar o escribir dirección web"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher ou saisir une adresse web"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोजें या वेब पता लिखें"
          }
        },
