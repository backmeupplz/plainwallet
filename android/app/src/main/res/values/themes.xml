<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- no title bar; the address bar sits on the wallet page's paper color (entrypoints/popup/style.css) -->
    <style name="Theme.PlainWallet" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light</item>
        <item name="android:windowLightNavigationBar">@bool/light</item>
    </style>
    <color name="paper">#F7F8FA</color>
    <color name="sheet">#E9ECF2</color>
    <color name="muted">#6A7390</color>
    <color name="pen">#2443C4</color>
    <bool name="light">true</bool>
</resources>
